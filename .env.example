# ---- Backend ----
# Comma-separated key pool (>= 2). Ids are key_1, key_2, ... in this order.
LLM_API_KEYS=your-gemini-key-1,your-gemini-key-2
# Any LiteLLM model string, e.g. gemini/gemini-2.0-flash, groq/llama-3.1-8b-instant, openai/gpt-4o-mini
LLM_MODEL=gemini/gemini-2.0-flash
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
DEFAULT_SYSTEM_PROMPT=You are a helpful, concise assistant.
# LiteLLM cache backend: local (in-memory) or disk (persists under CACHE_DIR)
CACHE_TYPE=disk
CACHE_DIR=/data/llm_cache
LLM_TIMEOUT_SECONDS=30
# true = fake replies without calling a provider (local testing only)
MOCK_LLM=false

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
